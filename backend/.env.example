ENV=dev   # без ENV=dev работает боевой режим: нужен JWT платформы, вход по приглашению
DATABASE_URL=sqlite:///./pochtelye.sqlite3
LOG_LEVEL=INFO
# Задаёт платформа skript.rt.ru:
# PY_PLATFORM_API_BASE=
# PY_PLATFORM_SEND_STATUS=
# Каталог ресурсов редактора (config.json, icons/, images/, ...), не в git:
# RESOURCES_DIR=D:/cod/EmailBuilder/shablon_rassilok/cache
# ADMIN_SUBS=["uuid-администратора"]

# Открытый ключ подписи JWT платформы (PEM, переводы строк как 
). Без него в проде приложение
# не стартует, пока явно не разрешено ALLOW_UNSIGNED_JWT=true (небезопасно, только до получения ключа).
# JWT_PUBLIC_KEY=
# ALLOW_UNSIGNED_JWT=false
